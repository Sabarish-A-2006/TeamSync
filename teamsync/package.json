{
  "name": "teamsync",
  "version": "1.0.0",
  "description": "TeamSync – Modern Full-Stack Real-Time Team Availability Tracker",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "server": "cd server && npm run dev",
    "server:prod": "cd server && npm start",
    "client": "cd client && npm run dev",
    "client:build": "cd client && npm run build",
    "install:all": "cd server && npm install && cd ../client && npm install",
    "test": "cd server && node tests/e2e.test.js"
  },
  "keywords": [
    "team-availability",
    "socket.io",
    "react",
    "express",
    "mongodb",
    "real-time",
    "mern"
  ],
  "author": "TeamSync Engineering",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
